{
  "bomFormat": "CycloneDX",
  "specVersion": "1.6",
  "version": 1,
  "metadata": {
    "component": {
      "type": "application",
      "name": "partner-gateway"
    }
  },
  "components": [
    {
      "type": "cryptographic-asset",
      "name": "TLS endpoint",
      "bom-ref": "partner-tls",
      "cryptoProperties": {
        "assetType": "protocol",
        "protocolProperties": {
          "type": "tls",
          "version": "1.2"
        }
      },
      "properties": [
        {
          "name": "workbench:kind",
          "value": "tls"
        },
        {
          "name": "workbench:observed",
          "value": "{\"versions\": [\"TLSv1.2\"]}"
        },
        {
          "name": "workbench:context",
          "value": "{\"owner\": \"Partners\", \"criticality\": \"high\", \"supports_tls13\": false, \"load_balancer\": \"Appliance\"}"
        }
      ]
    }
  ]
}
